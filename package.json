{
  "name": "boilerplate-backend",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node scripts/verifyEnvBackEnd.js && nodemon",
    "worker-dev": "cross-env NODE_ENV=development node scripts/verifyEnvBackEnd.js && nodemon --exec \"tsx src/agenda/worker.ts\"",
    "build:dev": "cross-env NODE_ENV=development node scripts/verifyEnvBackEnd.js && tsc -p tsconfig.build.json && tsc-alias",
    "build": "node scripts/verifyEnvBackEnd.js && tsc -p tsconfig.build.json && tsc-alias",
    "start": "node server/server.js",
    "worker-start": "node server/agenda/worker.js",
    "roles:sync": "tsx src/scripts/create-roles-and-permissions.ts",
    "audit:archive-setup": "tsx src/scripts/audit-archive-setup.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "ses-push": "tsx src/providers/email/templates/index.ts",
    "postinstall": "husky",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "engines": {
    "node": "^22.13.0"
  },
  "private": true,
  "overrides": {
    "thrift": {
      "uuid": "^10.0.0"
    }
  },
  "dependencies": {
    "@agendajs/mongo-backend": "4.0.3",
    "@aws-sdk/client-athena": "^3.1045.0",
    "@aws-sdk/client-s3": "^3.583.0",
    "@aws-sdk/client-ses": "^3.863.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@dsnp/parquetjs": ">=1.8.7 <1.9.3",
    "@onesignal/node-onesignal": "^5.2.1-beta1",
    "@workos-inc/node": "^8.12.0",
    "agenda": "6.2.6",
    "agendash": "^8.2.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.11",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "http-status": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "microdiff": "^1.5.0",
    "mime-types": "^2.1.35",
    "mongoose": "^8.4.0",
    "socket.io": "^4.8.1",
    "stream-chat": "^8.60.0",
    "stripe": "^15.12.0",
    "twilio": "^5.0.4",
    "ws": "^8.19.0",
    "xlsx": "^0.18.5",
    "yargs": "^17.7.2",
    "zod": "^4.3.4",
    "zod-express-validator": "^0.0.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^9.3.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.7.7",
    "@types/supertest": "^6.0.2",
    "@types/yargs": "^17.0.35",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.9.4",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
