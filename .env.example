# ==================================================================
# Environment configuration
# ==================================================================
# To set up: copy this file and fill in your values.
#   cp .env.example .env.development
#
# Which env file does the app read?
#   - On your machine: .env.development (one file is all you need)
#   - On servers:      no file — values are injected by the platform
#
# How this file is organized:
#   - App settings come first, then one section per external service.
#   - Inside each section, required keys come first, optional ones last.
#   - (required) = the app will not start without it
#   - (optional) = only needed for that feature
#   - Keys that already have a value are safe defaults for local use.
#
# Every key is checked on startup by src/config/env.ts —
# if you add or remove a key there, update this file too.
# ==================================================================


# ==================================================================
# Server
# ==================================================================
# One of: development | staging | production
NODE_ENV=development
PORT=8000
WORKER_PORT=8001
FRONTEND_HOST=http://localhost:3000
FRONTEND_INVITE_URL=http://localhost:3000/signup
# Multiple origins go as comma-separated values, e.g. `https://test1.com,https://test2.com`
ALLOWED_ORIGINS=http://localhost:3000
# Number of records generated by the test-data seeder
NUM_TEST_DATA=10


# ==================================================================
# Database (MongoDB)
# ==================================================================
DB_PATH=mongodb://localhost:27017/boilerplate


# ==================================================================
# Auth & Security
# ==================================================================
# Use long random strings in real environments, e.g. `openssl rand -hex 32`
JWT_SECRET=local-dev-jwt-secret
MFA_JWT_TOKEN_SECRET=local-dev-mfa-secret
OTP_HASH_SECRET=local-dev-otp-secret
# (required) Domain the auth cookies are scoped to — just the domain, no
# http:// or https:// prefix. e.g. `localhost` locally, `example.com` when deployed.
COOKIE_DOMAIN_NAME=localhost


# ==================================================================
# AWS (S3 / SES / Athena)
# ==================================================================
# (required) One IAM user's credentials, shared across S3, SES and Athena
AWS_USER_KEY=<aws-access-key-id>
AWS_USER_SECRET=<aws-secret-access-key>
S3_BUCKET_NAME=boilerplate-s3-upload
S3_BUCKET_REGION=us-east-2
# (required) SES emails — SES_SENDER_EMAIL is the "from" address and must be
# verified in SES. In development & staging, ALL outgoing email is redirected to
# SES_TEST_EMAIL (test with throwaway addresses, get everything in one inbox);
# only production emails the real recipient.
SES_SENDER_EMAIL=no-reply@example.com
SES_TEST_EMAIL=dev@example.com


# ==================================================================
# Stripe — https://dashboard.stripe.com/apikeys
# ==================================================================
# (required) Webhook secrets come from the webhook endpoint settings
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx
STRIPE_PAYMENT_WEBHOOK_SECRET=whsec_xxx

# ==================================================================
# WorkOS AuthKit — https://dashboard.workos.com
# ==================================================================
# (required)
WORKOS_API_KEY=sk_test_xxx
WORKOS_CLIENT_ID=client_xxx
WORKOS_WEBHOOK_SECRET=<workos-webhook-secret>


# ==================================================================
# Login security
# ==================================================================
# (optional) Kill switch for per-account login lockout. "false" restores the
# pre-lockout login behaviour exactly. Defaults to "true".
LOGIN_LOCKOUT_ENABLED=true


# ==================================================================
# Twilio (SMS) — https://console.twilio.com
# ==================================================================
# (required) Number in E.164 format
TWILIO_NUMBER=+15551234567
TWILIO_ACCOUNTSID=ACxxx
TWILIO_AUTHTOKEN=<twilio-auth-token>


# ==================================================================
# GetStream (chat) — https://dashboard.getstream.io
# ==================================================================
# (required)
GET_STREAM_MESSAGING_KEY=<getstream-api-key>
GET_STREAM_MESSAGING_SECRET=<getstream-api-secret>


# ==================================================================
# OneSignal (push notifications) — https://dashboard.onesignal.com
# ==================================================================
# (required)
ONE_SIGNAL_APP_ID=<onesignal-app-id>
ONE_SIGNAL_REST_API_KEY=<onesignal-rest-api-key>

# ==================================================================
# Athena / Glue / S3 (audit-log cold storage) — https://console.aws.amazon.com/athena
# ==================================================================
# (optional) The whole audit-log archive is opt-in. Audit logs always live in
# MongoDB (hot). If these are unset the app stays hot-only — nothing is archived,
# nothing breaks. Set them to move logs older than AUDIT_HOT_WINDOW_DAYS into S3
# (queried back via Athena). ATHENA_DATABASE and AUDIT_ARCHIVE_GLUE_DB must match.
ATHENA_DATABASE=audit_archive_db
AUDIT_ARCHIVE_GLUE_DB=audit_archive_db
AUDIT_ARCHIVE_BUCKET=your-audit-archive-bucket
ATHENA_OUTPUT_LOCATION=s3://your-audit-archive-bucket/athena-results/
# ATHENA_REGION defaults to S3_BUCKET_REGION if unset
ATHENA_REGION=ap-south-1
# Days audit logs stay in Mongo before the sweep archives them to S3
AUDIT_HOT_WINDOW_DAYS=90
